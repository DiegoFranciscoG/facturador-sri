# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.

# --- Backend ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Base de datos (Postgres; en produccion usar la cadena de conexion de Neon)
DB_URL=jdbc:postgresql://localhost:5432/facturador
DB_USER=facturador
DB_PASSWORD=CAMBIAR

# JWT: HS256, minimo 256 bits (32+ caracteres). Genera uno nuevo por entorno,
# por ejemplo con: openssl rand -base64 48
JWT_SECRET=CAMBIAR
JWT_EXPIRATION_MINUTES=30

# CORS: lista separada por comas de origenes permitidos (sin '*')
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Usuario administrador inicial (se crea una sola vez, al primer arranque)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR

# Rate limiting de login
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Integracion SRI ---
# SIMULADO (por defecto): habla con WireMock, sin RUC ni firma real.
# PRUEBAS-SRI: habla con el ambiente de pruebas real del SRI; requiere
# SRI_CERTIFICADO_P12_PATH y SRI_CERTIFICADO_P12_PASSWORD.
SRI_MODO=SIMULADO
SRI_AMBIENTE=1
SRI_RECEPCION_URL=http://localhost:8089/RecepcionComprobantesOffline
SRI_AUTORIZACION_URL=http://localhost:8089/AutorizacionComprobantesOffline
SRI_CERTIFICADO_P12_PATH=CAMBIAR
SRI_CERTIFICADO_P12_PASSWORD=CAMBIAR
SRI_REINTENTOS_MAX=5
SRI_REINTENTOS_BACKOFF_SEGUNDOS=30

# --- Frontend ---
API_BASE_URL=http://localhost:8080
